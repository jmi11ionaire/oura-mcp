# Option 1: Personal Access Token (find at https://cloud.ouraring.com/personal-access-tokens)
OURA_PERSONAL_ACCESS_TOKEN=your_personal_access_token

# Option 2: OAuth2 access token, with refresh support when available
OURA_ACCESS_TOKEN=your_oauth_access_token
OURA_REFRESH_TOKEN=your_oauth_refresh_token
OURA_TOKEN_EXPIRES_AT=1735689600000
OURA_CLIENT_ID=your_client_id
OURA_CLIENT_SECRET=your_client_secret
OURA_REDIRECT_URI=http://localhost:3000/callback

# Optional diagnostics. Logs request paths and query keys to stderr only.
OURA_DEBUG=false
